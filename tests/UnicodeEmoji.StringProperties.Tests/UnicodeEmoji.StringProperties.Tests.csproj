<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <!-- Golden data uses non-ASCII emoji literals. -->
    <NoWarn>$(NoWarn);CS1591;xUnit1069;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/UnicodeEmoji.StringProperties/UnicodeEmoji.StringProperties.csproj" />
    <ProjectReference Include="../../src/UnicodeEmoji.StringProperties.Generator/UnicodeEmoji.StringProperties.Generator.csproj" />
  </ItemGroup>

  <!-- Make the committed Unicode data files available to data-driven tests. -->
  <ItemGroup>
    <None Include="../../data/unicode/**/*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="data/unicode" />
  </ItemGroup>

</Project>
