<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Times the owner's normalization and case mapping (Broiler.Unicode.Algorithms over
    Broiler.Unicode.Tables) against the runtime's ICU-backed string.Normalize and casing, on the sample
    strings of Broiler.JS's and Broiler.VM's SJL-7 Unicode workloads. A tool for the owner's own
    performance work: no figure it prints is evidence for either engine's decision rules.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires optimized Release builds. -->
    <Optimize>true</Optimize>
    <RootNamespace>Broiler.Unicode.Algorithms.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Unicode.Algorithms/Unicode.Algorithms.csproj" />
    <ProjectReference Include="../../src/Unicode.Tables/Unicode.Tables.csproj" />
  </ItemGroup>

</Project>
